<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MannaggiaApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mannaggia">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gift links (Dono): verified by .well-known/assetlinks.json on demon86rm.github.io. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="demon86rm.github.io"
                    android:pathPrefix="/mannaggia/dono"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Card images for the share sheet (cache/condivisi), readable only by the chosen app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.condivisi"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/condivisi" />
        </provider>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".TrofeiActivity"
            android:exported="false"
            android:label="@string/trophies_title" />

        <activity
            android:name=".InfoActivity"
            android:exported="false" />

        <activity
            android:name=".AlbumActivity"
            android:exported="false"
            android:label="@string/album_title" />

        <!-- Quick Settings Tile -->
        <service
            android:name=".MannaggiaTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home Screen Widget -->
        <receiver
            android:name=".MannaggiaWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mannaggia.app.ACTION_INVOKE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mannaggia_widget_info" />
        </receiver>

    </application>
</manifest>
