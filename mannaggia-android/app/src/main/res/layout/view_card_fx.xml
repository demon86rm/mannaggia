<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen overlay for the card effects: the copy of a new card flying
     into the binder, and the "tap" hint of legendary cards (the whole overlay
     takes the tap while a legendary card waits for it). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fxRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:elevation="16dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/imgFly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Legendary cards wait for a tap: "Tocca per metterla nell'album". -->
    <TextView
        android:id="@+id/txtHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="96dp"
        android:background="#B3000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/card_tap_hint"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="#FFF4D58A"
        android:visibility="gone" />
</FrameLayout>
