<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay shown when a new saint enters the album: a card (portrait, number,
     name) that pops up, then shrinks into the binder. Legendary saints also get
     a pulsing gold glow behind the card and the sparkling frame. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:elevation="16dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/imgGlow"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/popCard"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="10dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/txtLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="6dp"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.mannaggia.app.SquareFrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/imgFrame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </com.mannaggia.app.SquareFrameLayout>

            <TextView
                android:id="@+id/txtNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/txtSaint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceTitleSmall" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
