<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <Button
        android:id="@+id/btnSettings"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnInfo"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- The phrase stays at the top; the card of its saint sits below it. -->
    <TextView
        android:id="@+id/txtResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textSize="28sp"
        android:text=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSettings" />

    <!-- Pulsing gold glow behind a new legendary card (see CardSlot). -->
    <ImageView
        android:id="@+id/imgGlow"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:contentDescription="@null"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cardFit"
        app:layout_constraintEnd_toEndOf="@id/cardFit"
        app:layout_constraintStart_toStartOf="@id/cardFit"
        app:layout_constraintTop_toTopOf="@id/cardFit" />

    <!-- The card of the last saint, between the phrase and the button. CardSlot
         scales this wrapper down when the space is short (small screens, long phrase). -->
    <FrameLayout
        android:id="@+id/cardFit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnMannaggia"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtResult">

        <include
            android:id="@+id/cardSlot"
            layout="@layout/view_card"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:visibility="invisible" />

        <!-- "NUOVA!" stamp over the top corner of a new card. -->
        <TextView
            android:id="@+id/txtStamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="-6dp"
            android:layout_marginEnd="-10dp"
            android:background="@drawable/bg_stamp"
            android:elevation="14dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:rotation="12"
            android:text="@string/card_stamp_new"
            android:textColor="#FFD32F2F"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/btnMannaggia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/btn_mannaggia"
        app:layout_constraintBottom_toTopOf="@id/progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Pixel-art card binder: opens the album; new cards fly into it. -->
    <ImageView
        android:id="@+id/btnAlbum"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_album"
        android:padding="4dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Saint of the day (pixel-art calendar), above the binder: one invocation a day,
         "ghost" (half transparent, disabled) once used or when no saint is celebrated. -->
    <ImageView
        android:id="@+id/btnSaintOfDay"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/saint_of_day_none"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnAlbum"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Trophies (pixel-art cup), on top of the bottom-right column. -->
    <ImageView
        android:id="@+id/btnTrophies"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_trophies"
        android:padding="4dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@id/btnSaintOfDay"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Trophy unlocked banner, sliding from the top (see TrophyPop). -->
    <include
        android:id="@+id/trophyPop"
        layout="@layout/view_trophy_pop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Card effects: copy flying into the binder, legendary tap hint (see CardSlot). -->
    <include
        android:id="@+id/cardFx"
        layout="@layout/view_card_fx"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
