<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/pref_cat_invoke"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="shake"
            android:defaultValue="true"
            android:title="@string/pref_shake_title"
            android:summary="@string/pref_shake_summary"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="card_anim"
            android:defaultValue="true"
            android:title="@string/pref_card_anim_title"
            android:summary="@string/pref_card_anim_summary"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="splash_choir"
            android:defaultValue="true"
            android:title="@string/pref_splash_choir_title"
            android:summary="@string/pref_splash_choir_summary"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="tts"
            android:defaultValue="false"
            android:title="@string/pref_tts_title"
            android:summary="@string/pref_tts_summary"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_style"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="theme"
            android:defaultValue="system"
            android:entries="@array/theme_names"
            android:entryValues="@array/theme_values"
            android:title="@string/pref_theme_title"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <com.mannaggia.app.StylePreviewPreference
            android:key="preview" />

        <ListPreference
            android:key="font"
            android:defaultValue="sans-serif"
            android:entries="@array/font_names"
            android:entryValues="@array/font_values"
            android:title="@string/pref_font_title"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="color"
            android:defaultValue="theme"
            android:entries="@array/color_names"
            android:entryValues="@array/color_values"
            android:title="@string/pref_color_title"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="effect"
            android:defaultValue="none"
            android:entries="@array/effect_names"
            android:entryValues="@array/effect_values"
            android:title="@string/pref_effect_title"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="colorful"
            android:defaultValue="false"
            android:title="@string/pref_colorful_title"
            android:summary="@string/pref_colorful_summary"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_cat_project"
        app:iconSpaceReserved="false">

        <Preference
            android:key="upcoming"
            android:title="@string/pref_upcoming_title"
            android:summary="@string/pref_upcoming_summary"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="issues"
            android:title="@string/pref_issues_title"
            android:summary="@string/pref_issues_summary"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="contribute"
            android:title="@string/pref_contribute_title"
            android:summary="@string/pref_contribute_summary"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
