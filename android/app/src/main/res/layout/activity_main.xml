<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:padding="24dp">

    <!-- Pixel-art ribbon buttons (see Avatars.ribbonButton): readable on both themes.
         2dp per pixel, padded to a 48dp touch target. -->
    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="@dimen/btn_settings_w"
        android:layout_height="@dimen/btn_settings_h"
        android:paddingVertical="2dp"
        android:clickable="true"
        android:contentDescription="@string/btn_settings"
        android:focusable="true"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnInfo"
        android:layout_width="@dimen/btn_info_w"
        android:layout_height="@dimen/btn_info_h"
        android:paddingVertical="5dp"
        android:clickable="true"
        android:contentDescription="@string/btn_info"
        android:focusable="true"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- The phrase, just above the card, growing upwards (two lines, typing). -->
    <TextView
        android:id="@+id/txtResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/result_gap"
        android:gravity="center"
        android:textSize="@dimen/result_text_size"
        android:text=""
        app:layout_constraintBottom_toTopOf="@id/cardFit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Pulsing gold glow behind a new legendary card (see CardSlot). -->
    <ImageView
        android:id="@+id/imgGlow"
        android:layout_width="@dimen/glow_size"
        android:layout_height="@dimen/glow_size"
        android:contentDescription="@null"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cardFit"
        app:layout_constraintEnd_toEndOf="@id/cardFit"
        app:layout_constraintStart_toStartOf="@id/cardFit"
        app:layout_constraintTop_toTopOf="@id/cardFit" />

    <!-- The card of the last saint, centred on the screen: the reference for the phrase
         (above) and the button (below). CardSlot narrows the card when they don't fit. -->
    <FrameLayout
        android:id="@+id/cardFit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/cardSlot"
            layout="@layout/view_card"
            android:layout_width="@dimen/card_max_width"
            android:layout_height="wrap_content"
            android:visibility="invisible" />

        <!-- "Nuova!" stamp (pixel art, see Avatars.newStamp) over the top corner of a new card. -->
        <ImageView
            android:id="@+id/imgStamp"
            android:layout_width="@dimen/stamp_width"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/stamp_margin_top"
            android:layout_marginEnd="@dimen/stamp_margin_end"
            android:adjustViewBounds="true"
            android:contentDescription="@string/card_stamp_new"
            android:elevation="14dp"
            android:rotation="12"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Pixel-art "Mannaggia!" ribbon (see Avatars.ribbonButton): centred on the
         saint-of-the-day icon, at most @dimen/btn_mannaggia_max, clear of the icon column (@dimen/icon_column). -->
    <ImageView
        android:id="@+id/btnMannaggia"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/icon_column"
        android:layout_marginEnd="@dimen/icon_column"
        android:adjustViewBounds="true"
        android:clickable="true"
        android:contentDescription="@string/btn_mannaggia"
        android:focusable="true"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/btnSaintOfDay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnSaintOfDay"
        app:layout_constraintWidth_max="@dimen/btn_mannaggia_max" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnMannaggia" />

    <!-- Pixel-art card binder: opens the album; new cards fly into it. -->
    <ImageView
        android:id="@+id/btnAlbum"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_album"
        android:padding="4dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Saint of the day (pixel-art calendar), above the binder: one invocation a day,
         "ghost" (half transparent, disabled) once used or when no saint is celebrated. -->
    <ImageView
        android:id="@+id/btnSaintOfDay"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/saint_of_day_none"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnAlbum"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Share the last invocation (card image and phrase), left of the "Mannaggia!" button. -->
    <ImageView
        android:id="@+id/btnShare"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/share_invocation"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/btnMannaggia"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnMannaggia" />

    <!-- Flip San Giovanni Battista's card (his secret back, see Retro): above the trophies,
         shown with a bounce whenever his card appears and the back is unlocked. -->
    <ImageView
        android:id="@+id/btnFlip"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/flip_card"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnTrophies"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Trophies (pixel-art cup), on top of the bottom-right column. -->
    <ImageView
        android:id="@+id/btnTrophies"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_trophies"
        android:padding="4dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@id/btnSaintOfDay"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Trophy unlocked banner, sliding from the top (see TrophyPop). -->
    <include
        android:id="@+id/trophyPop"
        layout="@layout/view_trophy_pop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Card effects: copy flying into the binder, legendary tap hint (see CardSlot). -->
    <include
        android:id="@+id/cardFx"
        layout="@layout/view_card_fx"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
