<?xml version="1.0" encoding="utf-8"?>
<!-- Album detail (bottom sheet): the card on parchment, legend badge, feast and discovery. It scrolls:
     on small screens the parchment card and the texts under it are taller than the sheet. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- The card on parchment, as on the home screen; its cardImage (portrait and frame) is also the
         image shared with "Condividi". -->
    <include
        layout="@layout/view_card"
        android:layout_width="240dp"
        android:layout_height="wrap_content" />

    <!-- Favourite on/off: the banner bookmark, full or empty. -->
    <ImageButton
        android:id="@+id/btnBookmarkDetail"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/fav_add"
        android:padding="6dp"
        android:scaleType="fitCenter" />

    <!-- Share the card (image and text), or gift it to a friend as a link (not the special cards). -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGift"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gift_button" />

        <!-- Flip San Giovanni Battista's card (his secret back, see Retro). -->
        <ImageButton
            android:id="@+id/btnFlip"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/flip_card"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtLegend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/album_legendary"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="#B8860B"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtFeast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <TextView
        android:id="@+id/txtFound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?android:attr/textColorSecondary" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
