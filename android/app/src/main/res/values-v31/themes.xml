        <item name="colorPrimary">#8B0000</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowSplashScreenBackground">#8B0000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_vuoto</item>
    </style>
</resources>
